# Copy to server/.env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://legacy:legacy@localhost:5432/class_legacy
# Origin of the web app (CORS + cookie)
WEB_ORIGIN=http://localhost:5173
# Require a TOTP code for privileged roles (always true in production)
REQUIRE_MFA=false
# Shared secret for payment-provider webhook signatures (HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET=change-me
SESSION_HOURS=12
