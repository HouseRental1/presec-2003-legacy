# ── Copy to server/.env for local development. On Vercel, set these in Project → Settings → Environment Variables.
# Never commit real secrets.

# Runtime
NODE_ENV=development                 # Vercel sets production automatically
DATABASE_URL=postgres://legacy:legacy@localhost:5432/class_legacy   # Vercel + Neon: set by the Neon integration (pooled)
# DATABASE_URL_UNPOOLED=             # Neon direct URL, used for migrations at build time
DB_POOL_MAX=10                       # use 3–5 on Vercel
APP_URL=http://localhost:5173        # public address of the app, e.g. https://classof2003.presec-legacy.org
WEB_ORIGIN=http://localhost:5173     # same as APP_URL in production
SESSION_HOURS=12
REQUIRE_MFA=false                    # always on in production for staff roles

# Payments
PAYMENT_PROVIDER=sandbox             # 'paystack' in production
PAYSTACK_SECRET_KEY=                 # sk_test_… for testing, sk_live_… when live
PAYSTACK_ENFORCE_IPS=false           # true in production (accept webhooks only from Paystack's addresses)
PAYMENT_WEBHOOK_SECRET=change-me     # sandbox only (development)

# Messages (until a provider is chosen, 'log' records messages without sending them)
SMS_PROVIDER=log                     # log | arkesel | hubtel
SMS_SENDER_ID=PRESEC03               # sender name registered with the SMS provider (max 11 characters)
ARKESEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
EMAIL_PROVIDER=log                   # log | resend
RESEND_API_KEY=
EMAIL_FROM=Class of 2003 Legacy <no-reply@your-domain.org>

# Scheduled jobs (Vercel Cron sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=                         # a long random string
